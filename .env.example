DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_PROXY_HTTPS=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
MODEM_BASE_URL=http://192.168.1.1
MODEM_VERIFY_TLS=true
MODEM_TIMEOUT=10
# Optional path to a trusted PEM CA bundle; takes precedence over MODEM_VERIFY_TLS.
MODEM_CA_BUNDLE=
# Set all PostgreSQL values to use it instead of SQLite.
# POSTGRES_DB=modem_manager
# POSTGRES_USER=modem_manager
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require

# Optional HTTP proxy: reachable by external proxy containers through the host.
PROXY_BIND_IP=0.0.0.0
PROXY_PORT=2500
# Existing network shared with NPM when using compose.npm.yaml.
NPM_NETWORK=
# Enable under the supplied single-worker Gunicorn configuration.
MODEM_MONITOR_ENABLED=false
MODEM_MONITOR_INTERVAL=30
# Refreshed by successful authenticated activity; not a fixed session lifetime.
MODEM_SESSION_IDLE_TIMEOUT=240
MODEM_HEALTH_FAILURE_THRESHOLD=3
MODEM_AUTO_RECONNECT_ENABLED=false
MODEM_AUTO_RECONNECT_COOLDOWN=300
MODEM_AUTO_RECONNECT_MAX_ATTEMPTS=3
MODEM_RECOVERY_VERIFY_DELAY=30
MODEM_AUTH_BACKOFF=300
# N5368X LTE outage mapping: ServiceStatus=0 with SysModeName=LTE.
# Verify for other firmware; leave empty to disable the outage mapping. Never include 1.
MODEM_LTE_UNAVAILABLE_STATUSES=0
# Paths only. Credentials come from protected mounted files, never environment passwords.
MODEM_USERNAME_FILE=/run/secrets/modem_username
MODEM_PASSWORD_FILE=/run/secrets/modem_password

# Host file paths for Compose interpolation; keep outside the repository.
MODEM_USERNAME_SECRET_PATH=
MODEM_PASSWORD_SECRET_PATH=
# Optional persistent container SQLite path:
# DJANGO_SQLITE_PATH=/data/db.sqlite3
